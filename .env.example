# Copy to .env and fill in. Never commit .env. Values here are dummies or empty.
# Comments sit on their own lines on purpose: inline "# ..." after an empty value is parsed
# differently by python-dotenv and docker compose.

# --- Database ---
POSTGRES_USER=studytrace
POSTGRES_PASSWORD=change-me
POSTGRES_DB=studytrace
# Host port for Postgres. Change it (and the port in DATABASE_URL) if 5432 is already in use.
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql+psycopg://studytrace:change-me@localhost:5432/studytrace

# --- Nebius Token Factory (the only model provider) ---
NEBIUS_API_KEY=
# Confirm this base URL in the Token Factory console (API section).
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Fill the three IDs from GET $NEBIUS_BASE_URL/models, then run `python scripts/check_models.py`.
# TODO(step 7): record the confirmed IDs in these comments and in the README.
#   nano  = classification, extraction, confidence (Nemotron Nano family)
#   super = conflicts, plans, quizzes, explain (Llama Nemotron Super family)
#   ultra = nightly consolidation (Llama Nemotron Ultra family)
MODEL_NANO=
MODEL_SUPER=
MODEL_ULTRA=

# --- Google (read-only scopes only) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/oauth/google/callback
# Fernet key; OAuth tokens are stored encrypted with it.
TOKEN_ENCRYPTION_KEY=

# --- Other services ---
TAVILY_API_KEY=
TELEGRAM_BOT_TOKEN=

# --- App ---
APP_TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO
